# ===========================================
# Rent-A-Buddy™ — Environment Variables
# ===========================================

# Neon database connection string (required)
# Get this from your Neon dashboard → Connection Details
RENTABUDDY_SECRET=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Session secret — any long random string (required)
SESSION_SECRET=change-me-to-a-long-random-string

# Admin account — seeded automatically on first startup (required)
ADMIN_EMAIL=admin@rentabuddy.com
ADMIN_PASSWORD=YourSecurePassword123!

# Public URL of your site (required)
APP_URL=https://rentabuddy.vip

# Server port (default: 5000)
PORT=5000
